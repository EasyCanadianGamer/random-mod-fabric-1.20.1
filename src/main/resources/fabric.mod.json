{
	"schemaVersion": 1,
	"id": "randommod",
	"version": "${version}",
	"name": "Random Mod",
	"description": "A Random Mod that adds Random things",
	"authors": [
		"Canadian Game!"
	],
	"contact": {
      "homepage": "https://modrinth.com/mod/randommod",
      "sources": "https://github.com/EasyCanadianGamer/random-mod-template-1.20.1"
	},
	"license": "MIT",
	"icon": "assets/randommod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.canadiangamer.randommod.RandomMod"
		],
